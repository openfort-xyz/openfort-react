# Openfort — create a project and get your keys at https://dashboard.openfort.io
VITE_OPENFORT_PUBLISHABLE_KEY=
VITE_SHIELD_PUBLISHABLE_KEY=

# Automatic recovery: a backend endpoint that returns an encryption session.
# The scaffolded backend serves this at /api/protected-create-encryption-session.
VITE_CREATE_ENCRYPTED_SESSION_ENDPOINT=

# Gas sponsorship policy id (optional). Without it, transactions are NOT sponsored
# and the connected wallet pays its own gas.
VITE_FEE_SPONSORSHIP_ID=

# WalletConnect project id (optional) — enables external wallets.
# Get one at https://dashboard.reown.com
VITE_WALLET_CONNECT_PROJECT_ID=

# Demo mint contracts (optional) — sensible testnet defaults are built in if unset.
VITE_BEAM_MINT_CONTRACT=
VITE_POLYGON_MINT_CONTRACT=

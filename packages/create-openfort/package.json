{
  "name": "create-openfort",
  "version": "1.0.1",
  "description": "Create Openfort applications with embedded wallets",
  "license": "Apache-2.0",
  "author": "Openfort (https://www.openfort.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openfort-xyz/openfort-react.git",
    "directory": "packages/create-openfort"
  },
  "keywords": [
    "create-openfort",
    "openfort",
    "embedded-wallets",
    "web3",
    "blockchain",
    "react",
    "vite",
    "typescript"
  ],
  "type": "module",
  "exports": "./dist/index.js",
  "bin": {
    "create-openfort": "./dist/index.js"
  },
  "files": [
    "dist",
    "template",
    "!template/**/node_modules",
    "!template/**/dist",
    "!template/**/.cache",
    "!template/**/.turbo",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".yarnrc.yml",
    "package.json"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "check": "tsc -p tsconfig.check.json && biome check",
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:standalone-solana": "OPENFORT_VERIFY_STANDALONE_SOLANA=1 vitest run test/standaloneSolana.test.ts",
    "test:build": "publint --strict"
  },
  "dependencies": {
    "@clack/prompts": "^0.6.3",
    "chalk": "5.2.0",
    "commander": "^10.0.1",
    "execa": "^7.2.0",
    "fs-extra": "^11.2.0",
    "gradient-string": "^2.0.2",
    "ora": "6.3.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^25.9.2",
    "tsup": "^8.3.5",
    "type-fest": "^3.13.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}

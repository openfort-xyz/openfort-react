{
  "compilerOptions": {
    // Type checking
    "strict": true,
    "noImplicitAny": false,

    // Emit — `rollup-plugin-typescript2` reads these to place declarations next to the bundles.
    "rootDir": "src",
    "outDir": "build",
    "declaration": true,
    "declarationDir": "build",
    "sourceMap": false,

    // Interop constraints
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    // Language and environment
    "module": "ESNext",
    "moduleResolution": "bundler", // Matches the rollup build: extensionless relative imports, `exports` maps honoured.
    "target": "ES2021",
    "lib": [
      "ES2022", // By using ES2022 we get access to the `.cause` property on `Error` instances.
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",

    // Skip type checking for node modules
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build", "src/**/*.test.ts", "src/**/*.test.tsx", "src/__tests__"],
  "watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriority",
    "synchronousWatchDirectory": true,
    "excludeDirectories": ["../node_modules", "build"]
  }
}

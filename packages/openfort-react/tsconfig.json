{
  "compilerOptions": {
    // Type checking
    "strict": true,
    "noFallthroughCasesInSwitch": true, // Not enabled by default in `strict` mode.
    "noImplicitOverride": true, // Not enabled by default in `strict` mode.
    "noImplicitReturns": true, // Not enabled by default in `strict` mode.
    "noUncheckedIndexedAccess": true, // Array and record lookups yield `T | undefined`, so they have to be guarded.
    "noUnusedLocals": true, // Not enabled by default in `strict` mode.
    "noUnusedParameters": true, // Not enabled by default in `strict` mode.
    // "exactOptionalPropertyTypes": true, // Enabled once supported in tanstack query https://github.com/TanStack/query/issues/7641

    // Emit — `rollup-plugin-typescript2` reads these to place declarations next to the bundles.
    "rootDir": "src",
    "outDir": "build",
    "declaration": true,
    "declarationDir": "build",
    "sourceMap": false,

    // Interop constraints
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true, // Imports are emitted as written, so type-only imports have to be marked `type`.

    // Language and environment
    "module": "ESNext",
    "moduleResolution": "bundler", // Matches the rollup build: extensionless relative imports, `exports` maps honoured.
    "target": "ES2021",
    "lib": [
      "ES2022", // By using ES2022 we get access to the `.cause` property on `Error` instances.
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",

    // Skip type checking for node modules
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build", "src/**/*.test.ts", "src/**/*.test.tsx", "src/__tests__"],
  "watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriority",
    "synchronousWatchDirectory": true,
    "excludeDirectories": ["../node_modules", "build"]
  }
}

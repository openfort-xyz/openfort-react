{
  "name": "@openfort/react",
  "version": "1.0.13",
  "author": "Openfort (https://www.openfort.io)",
  "license": "BSD-2-Clause license",
  "description": "The easiest way to integrate Openfort to your project.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openfort-xyz/openfort-react.git",
    "directory": "packages/openfort-react"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./solana": {
      "types": "./build/solana/index.d.ts",
      "import": "./build/solana/index.js"
    },
    "./ethereum": {
      "types": "./build/ethereum/index.d.ts",
      "import": "./build/ethereum/index.js"
    },
    "./wagmi": {
      "types": "./build/wagmi/index.d.ts",
      "import": "./build/wagmi/index.js"
    }
  },
  "types": "./build/index.d.ts",
  "typesVersions": {
    "*": {
      "solana": [
        "./build/solana/index.d.ts"
      ],
      "ethereum": [
        "./build/ethereum/index.d.ts"
      ],
      "wagmi": [
        "./build/wagmi/index.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=12.4"
  },
  "files": [
    "build",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "rollup --config rollup.config.dev.js -w",
    "dev": "rollup --config rollup.config.dev.js -w",
    "build": "rollup --config rollup.config.prod.js",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "react-hook",
    "blockchain",
    "hooks",
    "Openfort",
    "ethereum",
    "solana",
    "wallet",
    "react"
  ],
  "dependencies": {
    "@openfort/openfort-js": "^1.2.1",
    "buffer": "^6.0.3",
    "detect-browser": "^5.3.0",
    "fast-password-entropy": "^1.1.1",
    "framer-motion": "^6.3.11",
    "qrcode": "^1.5.0",
    "react-international-phone": "^4.6.0",
    "react-is": "^19.1.0",
    "react-transition-state": "^1.1.4",
    "react-use-measure": "^2.1.1",
    "resize-observer-polyfill": "^1.5.1",
    "styled-components": "^5.3.5",
    "zustand": "^5.0.11"
  },
  "peerDependencies": {
    "@solana/kit": "^2.0.0 || ^5.0.0",
    "react": "17.x || 18.x || 19.x",
    "react-dom": "17.x || 18.x || 19.x",
    "viem": "2.x",
    "wagmi": "2.x"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@tanstack/react-query": "^5.90.21",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/node": "18.7.18",
    "@types/qrcode": "^1.4.2",
    "@types/react": "^18.0.6",
    "@types/react-dom": "^18.0.2",
    "@types/styled-components": "^5.1.25",
    "@wagmi/connectors": "^6.2.0",
    "@wagmi/core": "^2.22.1",
    "happy-dom": "^20.8.9",
    "jsdom": "^28.1.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "^5.0.4",
    "typescript-plugin-styled-components": "^2.0.0",
    "vitest": "^2.0.0",
    "wagmi": "^2.18.2"
  },
  "peerDependenciesMeta": {
    "@solana/kit": {
      "optional": true
    },
    "wagmi": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  }
}

{
  "name": "@openfort/react",
  "version": "2.1.0",
  "author": "Openfort (https://www.openfort.io)",
  "license": "BSD-2-Clause",
  "description": "The easiest way to integrate Openfort to your project.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openfort-xyz/openfort-react.git",
    "directory": "packages/openfort-react"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./solana": {
      "types": "./build/solana/index.d.ts",
      "import": "./build/solana/index.js",
      "default": "./build/solana/index.js"
    },
    "./ethereum": {
      "types": "./build/ethereum/index.d.ts",
      "import": "./build/ethereum/index.js",
      "default": "./build/ethereum/index.js"
    },
    "./wagmi": {
      "types": "./build/wagmi/index.d.ts",
      "import": "./build/wagmi/index.js",
      "default": "./build/wagmi/index.js"
    },
    "./internal": {
      "types": "./build/internal/index.d.ts",
      "import": "./build/internal/index.js",
      "default": "./build/internal/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./build/index.d.ts",
  "typesVersions": {
    "*": {
      "solana": [
        "./build/solana/index.d.ts"
      ],
      "ethereum": [
        "./build/ethereum/index.d.ts"
      ],
      "wagmi": [
        "./build/wagmi/index.d.ts"
      ],
      "internal": [
        "./build/internal/index.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "rollup --config rollup.config.dev.js -w",
    "dev": "rollup --config rollup.config.dev.js -w",
    "build": "rm -rf build && rollup --config rollup.config.prod.js",
    "format": "biome format --write .",
    "size": "size-limit",
    "test": "vitest run",
    "test:build": "node scripts/check-use-client.mjs && publint --strict && attw --pack --profile esm-only",
    "test:cov": "vitest run --coverage",
    "test:types": "vitest run --typecheck",
    "test:watch": "vitest"
  },
  "keywords": [
    "react-hook",
    "blockchain",
    "hooks",
    "Openfort",
    "ethereum",
    "solana",
    "wallet",
    "react"
  ],
  "dependencies": {
    "@openfort/openfort-js": "^2.4.2",
    "buffer": "^6.0.3",
    "detect-browser": "^5.3.0",
    "fast-password-entropy": "^1.1.1",
    "framer-motion": "^12.42.2",
    "qrcode": "^1.5.0",
    "react-international-phone": "^4.6.0",
    "react-transition-state": "^1.1.4",
    "react-use-measure": "^2.1.1",
    "styled-components": "^5.3.5",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "@coinbase/wallet-sdk": "^4.3.6",
    "@safe-global/safe-apps-provider": "~0.18.6",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "@solana-program/compute-budget": "^0.12.0 || ^0.13.0",
    "@solana-program/system": "^0.10.0 || ^0.12.0",
    "@solana-program/token": "^0.9.0 || ^0.12.0",
    "@solana/kit": "^2.0.0 || ^5.0.0 || ^6.0.0",
    "@solana/kora": "^0.1.1 || ^0.2.0",
    "@tanstack/react-query": ">=5.99.2 <6",
    "@wagmi/core": "3.x",
    "@walletconnect/ethereum-provider": "^2.21.1",
    "react": ">=18.3.1 <20",
    "react-dom": ">=18.3.1 <20",
    "viem": ">=2.52.2 <3",
    "wagmi": "3.x"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@coinbase/wallet-sdk": "^4.3.7",
    "@safe-global/safe-apps-provider": "~0.18.6",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "@tanstack/react-query": "^5.101.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/node": "^25.9.2",
    "@types/qrcode": "^1.4.2",
    "@types/react": "^18.0.6",
    "@types/react-dom": "^18.0.2",
    "@types/styled-components": "^5.1.25",
    "@vitest/coverage-v8": "4.1.8",
    "@wagmi/connectors": "^8.0.15",
    "@wagmi/core": "^3.5.0",
    "@walletconnect/ethereum-provider": "^2.23.9",
    "happy-dom": "^20.10.2",
    "jsdom": "^29.1.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-typescript2": "^0.37.0",
    "typescript": "^5.9.3",
    "typescript-plugin-styled-components": "^2.0.0",
    "vitest": "^4.1.0",
    "wagmi": "^3.6.16"
  },
  "peerDependenciesMeta": {
    "@solana-program/compute-budget": {
      "optional": true
    },
    "@solana-program/system": {
      "optional": true
    },
    "@solana-program/token": {
      "optional": true
    },
    "@solana/kit": {
      "optional": true
    },
    "@solana/kora": {
      "optional": true
    },
    "wagmi": {
      "optional": true
    },
    "@wagmi/core": {
      "optional": true
    },
    "@coinbase/wallet-sdk": {
      "optional": true
    },
    "@walletconnect/ethereum-provider": {
      "optional": true
    },
    "@safe-global/safe-apps-provider": {
      "optional": true
    },
    "@safe-global/safe-apps-sdk": {
      "optional": true
    }
  }
}

{
  "name": "openfort-react",
  "version": "0.0.0",
  "description": "The easiest way to integrate Openfort to your project.",
  "main": "packages/openfort-react/src/index.ts",
  "private": true,
  "scripts": {
    "preinstall": "pnpx only-allow pnpm",
    "postinstall": "[ -n \"$CI\" ] || { git config --unset core.hooksPath 2>/dev/null || true; simple-git-hooks && ./.husky/check_gitleaks.sh; }",
    "verify": "pnpm check:audit && pnpm scan:secrets && pnpm check:repo && pnpm check:templates && pnpm check:release && pnpm check:peers && pnpm check && pnpm build && pnpm build:cli && pnpm check:types && pnpm test:types && pnpm test:cov && pnpm knip --production && pnpm test:build && pnpm test:env && pnpm size && pnpm build:docs",
    "check": "biome check",
    "check:repo": "sherif --fail-on-warnings --ignore-package playground --ignore-package 'quickstart-*' --ignore-package openfort-betterauth --ignore-package '@openfort-betterauth/*'",
    "check:release": "node scripts/test-release-contract.mjs",
    "check:peers": "node scripts/test-react-peer-alignment.mjs",
    "check:templates": "node scripts/sync-templates.js --check",
    "scan:secrets": "./.husky/run_gitleaks.sh",
    "check:fix": "biome check --write --unsafe",
    "check:types": "tsc --noEmit -p packages/openfort-react/tsconfig.check.json",
    "check:unused": "knip --no-config-hints",
    "check:audit": "pnpm audit",
    "check:quickstarts": "pnpm --filter 'quickstart-*' check && pnpm --filter openfort-betterauth check",
    "check:all": "pnpm check && pnpm check:types && pnpm check:unused && pnpm check:audit",
    "check:cli": "pnpm --filter create-openfort check",
    "sync-templates": "node scripts/sync-templates.js",
    "changeset": "changeset",
    "changeset:version": "pnpm check:templates && changeset version && node scripts/update-version.mjs && cp packages/openfort-react/CHANGELOG.md CHANGELOG.md",
    "changeset:prepublish": "pnpm check:templates && pnpm build && pnpm build:cli",
    "changeset:publish": "pnpm changeset:prepublish && changeset publish",
    "dev": "pnpm --filter @openfort/react dev",
    "dev:cli": "pnpm --filter create-openfort dev",
    "dev:firebase": "cd examples/quickstarts/firebase && pnpm dev",
    "dev:headless": "cd examples/quickstarts/headless && pnpm dev",
    "dev:openfort-ui": "cd examples/quickstarts/openfort-ui && pnpm dev",
    "dev:playground": "pnpm --filter playground dev",
    "build": "node scripts/update-version.mjs && pnpm --filter @openfort/react build && cp README.md packages/openfort-react/README.md",
    "build:cli": "pnpm --filter create-openfort build",
    "build:firebase": "cd examples/quickstarts/firebase && pnpm build",
    "build:headless": "cd examples/quickstarts/headless && pnpm build",
    "build:openfort-ui": "cd examples/quickstarts/openfort-ui && pnpm build",
    "build:supabase": "cd examples/quickstarts/supabase && pnpm build",
    "build:betterauth": "cd examples/quickstarts/betterauth && pnpm build",
    "build:docs": "typedoc --json docs/spec.json",
    "build:playground": "pnpm build && pnpm --filter playground build",
    "build:examples": "pnpm build && pnpm build:headless && pnpm build:openfort-ui && pnpm build:firebase && pnpm build:supabase && pnpm build:betterauth && pnpm --dir examples/quickstarts/solana-headless build && pnpm --filter playground build",
    "build:ci": "pnpm -r run build",
    "start:cli": "pnpm --filter create-openfort start",
    "size": "pnpm --filter @openfort/react size",
    "test": "pnpm --filter @openfort/react test && pnpm --filter playground test",
    "test:build": "pnpm --filter @openfort/react test:build && pnpm --filter create-openfort test:build",
    "test:unit": "pnpm --filter @openfort/react test",
    "test:types": "pnpm --filter @openfort/react test:types",
    "test:cov": "pnpm --filter @openfort/react test:cov",
    "test:cli": "pnpm --filter create-openfort test",
    "test:env": "pnpm test:env:tsc && pnpm test:env:node",
    "test:env:tsc": "pnpm --filter test-tsc test",
    "test:env:node": "pnpm --filter test-node test",
    "test:e2e": "pnpm --filter playground test",
    "test:ui": "pnpm --filter playground test:ui",
    "test:debug": "pnpm --filter playground test:debug"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/core": "^7.28.5",
    "@biomejs/biome": "^2.4.16",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@playwright/test": "^1.61.0",
    "@size-limit/preset-small-lib": "12.1.0",
    "knip": "^5.64.0",
    "publint": "0.3.22",
    "rollup": "^2.80.0",
    "sherif": "1.13.0",
    "simple-git-hooks": "^2.13.1",
    "size-limit": "12.1.0",
    "typedoc": "0.28.20",
    "typescript": "^5.9.3",
    "typescript-plugin-styled-components": "^2.0.0",
    "wagmi": "^3.6.16"
  },
  "packageManager": "pnpm@10.30.3",
  "knip": {
    "workspaces": {
      ".": {
        "entry": [
          "scripts/*.{js,mjs}!",
          "typedoc.json!"
        ]
      },
      "packages/openfort-react": {
        "entry": [
          "src/index.ts!",
          "src/ethereum/index.ts!",
          "src/solana/index.ts!",
          "src/wagmi/index.ts!",
          "src/internal/index.ts!",
          "scripts/*.mjs!",
          "src/**/*.test-d.ts"
        ],
        "ignoreBinaries": [
          "rollup"
        ],
        "ignore": [
          "src/__tests__/**"
        ],
        "ignoreDependencies": [
          "@coinbase/wallet-sdk",
          "@safe-global/safe-apps-provider",
          "@safe-global/safe-apps-sdk",
          "@wagmi/connectors",
          "@wagmi/core",
          "@walletconnect/ethereum-provider"
        ]
      },
      "environments/node": {
        "entry": [
          "esm.mjs!"
        ],
        "ignoreDependencies": [
          "@openfort/react",
          "@tanstack/react-query",
          "react",
          "react-dom",
          "viem",
          "wagmi"
        ]
      },
      "environments/tsc": {
        "entry": [
          "check.mjs!",
          "index.tsx!"
        ]
      }
    },
    "ignoreWorkspaces": [
      "examples/**"
    ],
    "ignoreExportsUsedInFile": true,
    "ignore": [
      "packages/openfort-react/rollup.config.dev.js",
      "packages/openfort-react/rollup.config.prod.js",
      "packages/openfort-react/rollup.use-client.js",
      "packages/create-openfort/template/**"
    ],
    "ignoreDependencies": [
      "@solana/kit",
      "@solana-program/compute-budget",
      "@solana-program/system",
      "@solana-program/token",
      "@solana/kora",
      "rollup-plugin-peer-deps-external",
      "rollup-plugin-typescript2",
      "typescript-plugin-styled-components",
      "buffer",
      "wagmi",
      "@babel/core",
      "@testing-library/react-hooks"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "./.husky/run_gitleaks.sh && pnpm check --staged --no-errors-on-unmatched"
  }
}
